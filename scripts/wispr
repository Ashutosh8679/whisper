#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd -- "$SCRIPT_DIR/.." && pwd)"

# If running from ~/.local/bin, PROJECT_DIR would be wrong - use absolute path
if [[ "$PROJECT_DIR" == "/home/ash/.local" ]]; then
    PROJECT_DIR="/home/ash/AI/wispr"
fi

VENV="$PROJECT_DIR/.venv"

if [[ ! -x "$VENV/bin/python" ]]; then
    echo "ERROR: Wispr virtual environment not found."
    echo
    echo "Expected:"
    echo "  $VENV"
    echo
    echo "Run ./install.sh first."
    exit 1
fi

SITE_PACKAGES="$("$VENV/bin/python" -c \
    'import site; print(site.getsitepackages()[0])'\
)"

export PYTHONPATH="$PROJECT_DIR${PYTHONPATH:+:$PYTHONPATH}"

CUDA_LIB_DIRS=()

for dir in \
    "$SITE_PACKAGES/nvidia/cublas/lib" \
    "$SITE_PACKAGES/nvidia/cudnn/lib"
do
    if [[ -d "$dir" ]]; then
        CUDA_LIB_DIRS+=("$dir")
    fi
done

if (( ${#CUDA_LIB_DIRS[@]} > 0 )); then
    CUDA_PATH="$(IFS=:; echo "${CUDA_LIB_DIRS[*]}")"
    export LD_LIBRARY_PATH="$CUDA_PATH${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

cd "$PROJECT_DIR"

# Handle daemon command specially - run in background with setsid
if [[ "$1" == "daemon" ]]; then
    # Check if already running using PID file
    pid_file="$HOME/.cache/wispr/wispr.pid"
    
    if [[ -f "$pid_file" ]]; then
        existing_pid=$(cat "$pid_file")
        if kill -0 "$existing_pid" 2>/dev/null; then
            echo "Wispr daemon is already running (PID: $existing_pid)."
            exit 0
        fi
        rm -f "$pid_file"
    fi
    
    # Also check for socket
    if [[ -S "$HOME/.cache/wispr/wispr.sock" ]] && "$VENV/bin/python" -c \
        "import socket; s=socket.socket(); s.connect('$HOME/.cache/wispr/wispr.sock'); s.close()" 2>/dev/null; then
        echo "Wispr daemon is already running."
        exit 0
    fi
    
    echo "Starting Wispr daemon..."
    setsid "$VENV/bin/python" -m src.cli daemon > "$HOME/.local/state/wispr/daemon.log" 2>&1 &
    disown
    sleep 3
    
    # Verify it started
    if pgrep -f "wispr.*daemon" >/dev/null; then
        echo "Wispr daemon started successfully."
        echo "Logs: $HOME/.local/state/wispr/daemon.log"
        echo "Socket: $HOME/.cache/wispr/wispr.sock"
    else
        echo "Warning: Daemon may have failed to start."
        tail -20 "$HOME/.local/state/wispr/daemon.log"
    fi
    exit 0
fi

exec "$VENV/bin/python" -m src.cli "$@"