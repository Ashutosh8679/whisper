[Unit]
Description=Global Whisper Hold-to-Talk Hotkey
After=graphical-session.target whisper.service
Wants=graphical-session.target
Requires=whisper.service

[Service]
Type=simple

# The installation procedure should place the Whisper
# launcher at ~/.local/bin/whisper-hotkey.
ExecStart=%h/.local/bin/whisper-hotkey

Restart=on-failure
RestartSec=3

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target