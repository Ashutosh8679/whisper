[Unit]
Description=Local Wispr Transcription Daemon
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple

# The installation procedure should place the Wispr
# launcher at ~/.local/bin/wispr.
ExecStart=%h/.local/bin/wispr daemon

Restart=on-failure
RestartSec=5

Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target